<Window x:Class="Blackjack.DeckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blackjack"
        Title="Deck Inspector — Authorized Cheating" Height="550" Width="650"
        Background="#FAF9F6" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <local:CardImageConverter x:Key="CardConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side: ListBox and Buttons -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="DECK INSPECTOR" FontWeight="Bold" FontSize="16" Margin="0,0,0,5"/>

            <ListBox x:Name="DeckListBox" Grid.Row="1" Margin="0,0,10,10"
                     ItemsSource="{Binding}"
                     DisplayMemberPath="Name"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Move Up" Width="80" Height="30" Margin="0,0,10,0" Click="MoveUp_Click"/>
                <Button Content="Move Down" Width="80" Height="30" Click="MoveDown_Click"/>
            </StackPanel>
        </Grid>

        <!-- Right Side: Selected Card Image Preview -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Selected card" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White" CornerRadius="4" Padding="5">
                <Image Width="150" Height="220"
                       Source="{Binding SelectedItem, ElementName=DeckListBox, Converter={StaticResource CardConverter}}"/>
            </Border>
            <TextBlock Text="{Binding SelectedItem.Name, ElementName=DeckListBox}" 
                       HorizontalAlignment="Center" Margin="0,10,0,0" FontStyle="Italic"/>
        </StackPanel>
    </Grid>
</Window>