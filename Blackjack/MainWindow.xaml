<Window x:Class="Blackjack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blackjack"
        Title="Blackjack" Height="700" Width="1000"
        Background="#1B4D3E" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:CardImageConverter x:Key="CardConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="BLACKJACK TABLE" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Dealer sticks with initial two cards." FontSize="14" Foreground="#DDDDDD"/>
        </StackPanel>

        <!-- Dealer Section -->
        <GroupBox Grid.Row="1" Header="{Binding DealerScoreHeader}" Foreground="White" BorderBrush="White" Margin="0,0,0,10" Padding="10">
            <ListBox ItemsSource="{Binding DealerHand}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" Background="White" CornerRadius="4" Padding="3">
                            <Image Width="90" Height="130" Source="{Binding Converter={StaticResource CardConverter}}"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Player Section -->
        <GroupBox Grid.Row="2" Header="{Binding PlayerScoreHeader}" Foreground="White" BorderBrush="White" Margin="0,0,0,15" Padding="10">
            <ListBox ItemsSource="{Binding PlayerHand}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" Background="White" CornerRadius="4" Padding="3">
                            <Image Width="90" Height="130" Source="{Binding Converter={StaticResource CardConverter}}"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="New Game" Width="100" Height="35" Margin="0,0,10,0" Click="NewGame_Click"/>
            <Button Content="Hit" Width="80" Height="35" Margin="0,0,10,0" Click="Hit_Click"/>
            <Button Content="Deck Inspector" Width="120" Height="35" Click="OpenDeckWindow_Click"/>
        </StackPanel>
    </Grid>
</Window>